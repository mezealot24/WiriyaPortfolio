---
import { defaultLocale, ogLocale, otherLocale, type Locale } from "@/i18n/locales";
import { brand } from "@/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page in the other language, only when that page exists. */
  translation?: string | undefined;
  type?: "website" | "article";
  noindex?: boolean;
}

const { locale, title, description, translation, type = "website", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://silicon-warin.vercel.app");
const canonical = new URL(Astro.url.pathname, site).href;
const other = otherLocale(locale);
const alternates: Array<{ lang: string; href: string }> = [{ lang: locale, href: canonical }];
if (translation) alternates.push({ lang: other, href: new URL(translation, site).href });
const thaiHref = alternates.find((a) => a.lang === defaultLocale)?.href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{
  !noindex && translation && (
    <>
      {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
      {thaiHref && <link rel="alternate" hreflang="x-default" href={thaiHref} />}
    </>
  )
}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={brand.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[locale]} />
{translation && <meta property="og:locale:alternate" content={ogLocale[other]} />}
<meta name="twitter:card" content="summary" />
