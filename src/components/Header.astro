---
import LineButton from "@/components/LineButton.astro";
import Logo from "@/components/Logo.astro";
import { localePath, type Locale } from "@/i18n/locales";
import { copyFor } from "@/i18n/t";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale);
const here = Astro.url.pathname;
const links = [
  { href: localePath(locale, "services"), label: c.nav.services },
  { href: localePath(locale, "work"), label: c.nav.work },
  { href: localePath(locale, "about"), label: c.nav.about },
  { href: localePath(locale, "insights"), label: c.nav.insights },
];
const current = (href: string) => (here === href || here.startsWith(href) ? "page" : undefined);
---

<header class="header" id="top">
  <div class="container header__in">
    <Logo href={localePath(locale)} label={c.a11y.homeLink} />
    <nav class="nav" aria-label={c.a11y.mainNav}>
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
    <button class="icon-btn theme-toggle" type="button" id="themeToggle" aria-label={c.a11y.theme}>
      <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"></path></svg>
      <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
    </button>
    <LineButton locale={locale} position="header" label={c.line.talk} size="sm" class="header__cta" />
    <button
      class="icon-btn menu-btn"
      type="button"
      id="menuBtn"
      aria-expanded="false"
      aria-controls="mnav"
      aria-label={c.a11y.openMenu}
      data-open={c.a11y.openMenu}
      data-close={c.a11y.closeMenu}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
    </button>
  </div>
</header>
<nav class="mnav" id="mnav" aria-label={c.a11y.mobileNav}>
  {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
  <a href={localePath(locale, "contact")} aria-current={current(localePath(locale, "contact"))}>{c.nav.contact}</a>
  <LineButton locale={locale} position="mobile-menu" label={c.line.talk} block icon={false} />
</nav>
