---
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
import { localePath, otherLocale, type Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/t";
import { contactEmail, lineUrl } from "@/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const tell = ["contact.tell1", "contact.tell2", "contact.tell3", "contact.tell4"] as const;
---

<Base
  locale={locale}
  title={t("contact.metaTitle")}
  description={t("contact.metaDescription")}
  translation={localePath(otherLocale(locale), "contact")}
>
  <div class="wr-container">
    <PageHead title={t("contact.headline")} lead={t("contact.lead")}>
      <div class="wr-row" data-reveal>
        {lineUrl && <Button size="md" href={lineUrl} icon="arrow-up-right" external>{t("cta.line")}</Button>}
        {
          contactEmail && (
            <a class="wr-link" href={`mailto:${contactEmail}`}>
              <Icon name="mail" /> {contactEmail}
            </a>
          )
        }
      </div>
      {!lineUrl && <p class="wr-meta">{t("contact.noLine")}</p>}
    </PageHead>

    <div class="wr-prose wr-section" data-reveal>
      <h2>{t("contact.tellTitle")}</h2>
      <ul>{tell.map((key) => <li>{t(key)}</li>)}</ul>
      <p>{t("cta.reply")}</p>
    </div>
  </div>
</Base>
