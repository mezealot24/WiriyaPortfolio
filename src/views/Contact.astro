---
import CopyEmail from "@/components/CopyEmail.astro";
import LeadForm from "@/components/LeadForm.astro";
import LineButton from "@/components/LineButton.astro";
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { packagesFor, slugOf } from "@/i18n/content";
import { localePath, otherLocale, type Locale } from "@/i18n/locales";
import { copyFor } from "@/i18n/t";
import { breadcrumbs, page } from "@/lib/schema";
import { availability, contactEmail, lineUrl } from "@/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copyFor(locale);
const k = c.contact;
const site = Astro.site ?? new URL("https://siliconwarin.com");
const path = localePath(locale, "contact");
const packages = (await packagesFor(locale)).map((p) => ({ slug: slugOf(p.id), name: p.data.name }));
const crumbs = [
  { name: c.nav.home, path: localePath(locale) },
  { name: c.nav.contact, path },
];
---

<Base
  locale={locale}
  title={k.title}
  description={k.description}
  translation={localePath(otherLocale(locale), "contact")}
  schema={[page(site, locale, "ContactPage", path, k.title, k.description), breadcrumbs(site, crumbs)]}
>
  <PageHero id="h-page" eyebrow={k.eyebrow} title={k.h1} sub={k.sub} crumbs={crumbs} crumbsLabel={c.a11y.breadcrumb} />

  <section class="section" style="padding-top:var(--space-5)" aria-label={k.formTitle}>
    <div class="container split">
      <div class="stack" style="gap:var(--space-6)">
        <div class="card channel" data-reveal data-bar-stop>
          <h2 style="font-size:var(--fs-lg)">{k.lineTitle}</h2>
          {
            lineUrl ? (
              <>
                <LineButton locale={locale} position="contact" label={c.line.addFriend} />
                {/* TODO(owner): add the LINE OA QR code image beside the button on desktop. */}
              </>
            ) : (
              <p class="notice">{k.lineMissing}</p>
            )
          }
          <p class="hero__micro" style="margin:0">
            <span class="pulse" aria-hidden="true"></span>{availability === "booked" ? c.line.booked : c.line.reassure}
          </p>
        </div>
        <div data-reveal>
          <h2 style="font-size:var(--fs-lg);margin-bottom:var(--space-4)">{k.afterTitle}</h2>
          <ol class="after">{k.after.map((line) => <li>{line}</li>)}</ol>
        </div>
        {
          contactEmail && (
            <div data-reveal>
              <h2 style="font-size:var(--fs-lg);margin-bottom:var(--space-2)">{k.otherTitle}</h2>
              <p class="muted" style="font-size:var(--fs-sm)">{k.email}</p>
              <CopyEmail locale={locale} email={contactEmail} />
            </div>
          )
        }
      </div>
      <div>
        <h2 class="sr-only">{k.formTitle}</h2>
        <LeadForm locale={locale} kind="contact" packages={packages} />
      </div>
    </div>
  </section>
</Base>
