---
import Base from "@/layouts/Base.astro";
import { localePath, type Locale } from "@/i18n/locales";
import { copyFor } from "@/i18n/t";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copyFor(locale);
const n = c.notFound;
---

<Base locale={locale} title={n.title} description={c.meta.siteDescription} noindex>
  <section class="page-hero" aria-labelledby="h-page" data-bar-start>
    <div class="container">
      <p class="eyebrow">{n.eyebrow}</p>
      <h1 id="h-page">{n.h1}</h1>
      <p class="hero__sub">{n.sub}</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={localePath(locale)}>{n.home}</a>
        <a class="btn btn--ghost" href={localePath(locale, "services")}>{c.nav.services} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      {locale === "th" && <p class="muted" lang="en" style="margin-top:var(--space-6);font-size:var(--fs-sm)"><a class="link" href={localePath("en")}>{n.en} <span class="arrow" aria-hidden="true">→</span></a></p>}
    </div>
  </section>
</Base>
