---
import CaseCard from "@/components/CaseCard.astro";
import Checks from "@/components/Checks.astro";
import Faq from "@/components/Faq.astro";
import FinalCta from "@/components/FinalCta.astro";
import LeadForm from "@/components/LeadForm.astro";
import LineButton from "@/components/LineButton.astro";
import PackageCard from "@/components/PackageCard.astro";
import ProofStrip from "@/components/ProofStrip.astro";
import Base from "@/layouts/Base.astro";
import { packagesFor, workFor } from "@/i18n/content";
import { localePath, otherLocale, type Locale } from "@/i18n/locales";
import { copyFor } from "@/i18n/t";
import { faqPage, webSite } from "@/lib/schema";
import { availability } from "@/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copyFor(locale);
const h = c.home;
const site = Astro.site ?? new URL("https://siliconwarin.com");
const packages = await packagesFor(locale);
const work = await workFor(locale);
const featured = work.find((w) => w.data.featured) ?? work[0];
const faq = c.faq.slice(0, 5);
---

<Base
  locale={locale}
  title={h.title}
  description={h.description}
  translation={localePath(otherLocale(locale))}
  schema={[webSite(site, locale), faqPage(faq)]}
>
  <!-- 1. Hero + 2. Proof strip -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="container">
      <p class="eyebrow" data-reveal>{h.eyebrow}</p>
      <h1 id="h-hero" data-reveal style="--i:1" set:html={h.h1Html} />
      <p class="hero__sub" data-reveal style="--i:2" set:html={h.subHtml} />
      <div class="hero__cta" data-reveal style="--i:3" data-bar-start>
        <LineButton locale={locale} position="hero" label={c.line.talk} magnetic />
        <a class="btn btn--ghost" href={localePath(locale, "work")}>{h.seeWork} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p class="hero__micro" data-reveal style="--i:4">
        <span class="pulse" aria-hidden="true"></span>{availability === "booked" ? c.line.booked : c.line.reassure}
      </p>
      {featured && <ProofStrip locale={locale} entry={featured} />}
    </div>
  </section>

  <!-- 3. Problems -->
  <section class="section" aria-labelledby="h-problems">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="eyebrow">Problems</p>
        <h2 id="h-problems">{h.problemsTitle}</h2>
      </div>
      <ul class="grid grid--2">
        {
          h.problemsHtml.map((item, i) => (
            <li class="card problem" data-reveal style={i % 2 ? "--i:1" : undefined}>
              <span class="problem__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <p set:html={item} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Packages -->
  <section class="section section--tint" aria-labelledby="h-services">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="eyebrow">Services</p>
        <h2 id="h-services">{h.packagesTitle}</h2>
      </div>
      <div class="grid grid--3">
        {packages.map((entry, i) => <PackageCard locale={locale} entry={entry} context="home" index={i} />)}
      </div>
      <p class="price-note" data-reveal>
        <span>{c.common.priceNote}</span>
        <a class="link" href={`${localePath(locale, "services")}#compare`}>{h.compareLink} <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- 5. Featured case -->
  {
    featured && (
      <section class="section" aria-labelledby="h-case">
        <div class="container">
          <CaseCard locale={locale} entry={featured} id="h-case" />
        </div>
      </section>
    )
  }

  <!-- 6. Process -->
  <section class="section section--tint" aria-labelledby="h-process">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="eyebrow">Process</p>
        <h2 id="h-process">{h.processTitle}</h2>
      </div>
      <ol class="steps">
        {
          c.process.map((step, i) => (
            <li class="step" data-reveal style={i ? `--i:${i}` : undefined}>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 7. Why -->
  <section class="section" aria-labelledby="h-why">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="eyebrow">Why</p>
        <h2 id="h-why">{h.whyTitle}</h2>
      </div>
      <ul class="why">
        {
          h.why.map((item) => (
            <li class="why__item" data-reveal>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Audit -->
  <section class="section section--tint" id="audit" aria-labelledby="h-audit">
    <div class="container audit">
      <div data-reveal>
        <p class="eyebrow">Free audit</p>
        <h2 id="h-audit">{h.auditTitle}</h2>
        <p class="muted" style="margin-top:var(--space-4)">{h.auditSub}</p>
        <Checks items={h.auditList} class="audit__list" />
      </div>
      <LeadForm locale={locale} kind="audit" />
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section" aria-labelledby="h-faq">
    <div class="container">
      <div class="section__head" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 id="h-faq">{h.faqTitle}</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- 10. Final CTA -->
  <FinalCta locale={locale} title={h.finalTitle} sub={h.finalSub} />
</Base>
