---
import CaseCard from "@/components/CaseCard.astro";
import FinalCta from "@/components/FinalCta.astro";
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { slugOf, workFor } from "@/i18n/content";
import { localePath, otherLocale, type Locale } from "@/i18n/locales";
import { copyFor } from "@/i18n/t";
import { breadcrumbs, itemList, page } from "@/lib/schema";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = copyFor(locale);
const w = c.work;
const site = Astro.site ?? new URL("https://siliconwarin.com");
const path = localePath(locale, "work");
const work = await workFor(locale);
const crumbs = [
  { name: c.nav.home, path: localePath(locale) },
  { name: c.nav.work, path },
];
const items = work.map((e) => ({ name: e.data.title, path: localePath(locale, `work/${slugOf(e.id)}`) }));
---

<Base
  locale={locale}
  title={w.title}
  description={w.description}
  translation={localePath(otherLocale(locale), "work")}
  schema={[page(site, locale, "CollectionPage", path, w.h1, w.description), itemList(site, items), breadcrumbs(site, crumbs)]}
>
  <PageHero id="h-page" eyebrow={w.eyebrow} title={w.h1} sub={w.sub} crumbs={crumbs} crumbsLabel={c.a11y.breadcrumb} />

  <section class="section" style="padding-top:var(--space-5)" aria-label={c.nav.work}>
    <div class="container stack" style="gap:var(--space-6)">
      {work.map((entry, i) => <CaseCard locale={locale} entry={entry} id={`h-case-${i}`} />)}
      <div class="card coming" data-reveal>
        <span class="badge" style="justify-self:start">Coming soon</span>
        <h2 style="font-size:var(--fs-lg)">{w.comingTitle}</h2>
        <p>{w.comingBody}</p>
      </div>
      <p class="notice" data-reveal>{w.proofNote}</p>
    </div>
  </section>

  <FinalCta locale={locale} title={w.ctaTitle} sub={w.ctaSub} line={c.line.talk} secondary={{ href: localePath(locale, "audit"), label: c.services.auditCta }} />
</Base>
