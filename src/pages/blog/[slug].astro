---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BlogPost from "@/views/BlogPost.astro";
import { pathsFor } from "@/i18n/content";

export const getStaticPaths = (() => pathsFor("blog", "th")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
---

<BlogPost locale="th" entry={entry} />
