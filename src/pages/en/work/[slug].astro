---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import WorkDetail from "@/views/WorkDetail.astro";
import { pathsFor } from "@/i18n/content";

export const getStaticPaths = (() => pathsFor("work", "en")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
---

<WorkDetail locale="en" entry={entry} />
