# Copy to .env for local work. Nothing here is secret; every value ends up in the built pages.

# The LINE Official Account add-friend link. Without it, contact buttons lead to the contact page.
PUBLIC_LINE_URL=

# The brand email shown on the contact page. Use a brand address, never one that carries the owner's legal name.
PUBLIC_CONTACT_EMAIL=

# available | booked
PUBLIC_AVAILABILITY=available

# Set on the host, not here: .env files are not read by astro.config.ts.
# SITE_URL=https://example.com
