# Copy to .env for local work. Nothing here is secret; every value ends up in the built pages.

# TODO(owner): the LINE Official Account add-friend link. Without it, LINE buttons lead to the contact page.
PUBLIC_LINE_URL=

# TODO(owner): LINE OA basic ID without "@". Enables package links with a pre-filled message.
PUBLIC_LINE_ID=

# TODO(owner): the brand email on the final domain. Without it, the email line is hidden.
PUBLIC_CONTACT_EMAIL=

# available | booked
PUBLIC_AVAILABILITY=available

# Set on the host, not here: .env files are not read by astro.config.ts.
# SITE_URL=https://siliconwarin.com
